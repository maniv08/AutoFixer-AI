# AutoFixer AI Environment Configuration

# LLM Provider: 'gemini' | 'openai' | 'anthropic' | 'ollama' | 'mock'
LLM_PROVIDER=gemini
MODEL_NAME=gemini-2.0-flash

# API Keys (Provide your provider's key, or leave blank to use the autonomous demo agent)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Sandbox Security Configuration
# 'process' (Recommended for standard cloud hosting like Render/Railway/Cloud Run) or 'docker'
SANDBOX_TYPE=process
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=512

# Agent Loop Settings
MAX_ITERATIONS=5
ENABLE_LINTER=true
ENABLE_STATIC_ANALYSIS=true

# Server Settings
HOST=0.0.0.0
PORT=8000
