# AutoFixer AI - Frontend Environment Variables

# URL of the deployed AutoFixer FastAPI backend (Render, Railway, Fly.io, or VPS)
VITE_API_URL=https://your-backend-service.onrender.com

# (Optional) Direct WebSocket URL override.
# If not specified, AutoFixer automatically derives wss:// from VITE_API_URL.
# VITE_WS_URL=wss://your-backend-service.onrender.com

# ----------------------------------------------------
# 🔐 Firebase Authentication (Google, GitHub & Email/Password)
# Obtain these from: https://console.firebase.google.com -> Project Settings -> General -> Web App
# ----------------------------------------------------
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
